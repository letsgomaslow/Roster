# Storage configuration
# Possible values: file, postgres, memory, convex
STORAGE_TYPE=file

# Convex (see convex-cloud.env.template and OPERATIONS.md)
# CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# For Convex CLI: copy convex-cloud.env.template → .env.local (CONVEX_DEPLOYMENT=prod:… or dev:…)

# File storage configuration
#PROMPTS_DIR=./prompts

# PostgreSQL storage configuration
# Required when STORAGE_TYPE=postgres
PG_CONNECTION_STRING=postgresql://localhost/mydb

# Server configuration
SERVER_NAME=mcp-prompts
SERVER_VERSION=3.0.8
LOG_LEVEL=debug

ENABLE_SSE=true
HTTP_SERVER=true
#PROMPTS_DIR=/app/data/prompts
MODE=mcp
MCP_SERVER=true
MCP_MODE=true
PORT=3003
